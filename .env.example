# ───────────────────────────────────────────────────────────
# Via Trips API — environment configuration
# Copy this file to `.env` and adjust values for your machine.
# ───────────────────────────────────────────────────────────

# PostgreSQL connection string (required for Prisma)
DATABASE_URL="postgresql://postgres:125698@localhost:5432/via_db"

# Mock auth — set to "true" to skip Firebase and use local JWT.
# When "false", the FirebaseAuthGuard will verify Firebase ID tokens
# (Firebase Admin SDK must be initialised in src/main.ts).
MOCK_AUTH=true

# Secret used to sign dev JWTs. Replace with a strong secret in production.
JWT_SECRET="dev-only-super-secret-change-me-in-production"
JWT_EXPIRES_IN="7d"

# CORS — comma-separated list of allowed origins
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# Upload directory for KYC documents (relative to apps/api root)
UPLOAD_DIR="./uploads"

# Server
PORT=3001
API_PREFIX=v1

# ── Demo accounts (seeded on boot when MOCK_AUTH=true) ────
# These are for local testing only. Remove or set SEED_DEMO_ACCOUNTS=false
# before deploying to production.
SEED_DEMO_ACCOUNTS=true
DEMO_HOTEL_EMAIL="hotel@viatrips.com"
DEMO_HOTEL_PASSWORD="password123"
DEMO_BUNDLE_EMAIL="bundle@viatrips.com"
DEMO_BUNDLE_PASSWORD="password123"

# ── Firebase (for later production auth) ───────────────────
# FIREBASE_PROJECT_ID=""
# FIREBASE_CLIENT_EMAIL=""
# FIREBASE_PRIVATE_KEY=""
