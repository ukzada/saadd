// Prisma schema for Via Trips API
// See: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────────────────────────────────────
// User & Auth
// ───────────────────────────────────────────────────────────

enum UserRole {
  HotelOwner
  BundleCreator
  Traveler
  Admin
}

enum KycStatus {
  NotSubmitted
  Pending
  Approved
  Rejected
}

enum KycDocumentType {
  BusinessLicense
  IdProof
  TaxCertificate
  HotelLicense
  PropertyOwnership
  TourGuideLicense
}

enum SubscriptionPlanType {
  Monthly
  Commission
}

enum SubscriptionStatus {
  Trial
  Pending
  Active
  Expired
  Cancelled
  Suspended
}

model User {
  id                 String                @id @default(cuid())
  email              String                @unique
  passwordHash       String?
  name               String
  role               UserRole              @default(HotelOwner)
  phone              String?
  companyName        String?
  businessLicense    String?
  tourGuideLicense   String?
  yearsExperience    Int?
  languagesSpoken    String[]
  avatarUrl          String?
  firebaseUid        String?               @unique
  kycStatus          KycStatus             @default(NotSubmitted)
  kycSubmittedAt     DateTime?
  kycReviewedAt      DateTime?
  kycRejectionReason String?
  subscriptionStatus SubscriptionStatus    @default(Trial)
  currentPlanName    String?
  currentPlanType    SubscriptionPlanType?
  nextBillingAt      DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  hotels          Hotel[]
  bundles         Bundle[]
  bookings        Booking[]
  kycDocs         KycDocument[]
  subscriptions   UserSubscription[]

  @@map("users")
}

model SubscriptionPlan {
  id            String                 @id @default(cuid())
  name          String
  slug          String                 @unique
  type          SubscriptionPlanType
  description   String?
  priceMonthly  Decimal?               @db.Decimal(10, 2)
  commissionRate Decimal?              @db.Decimal(5, 2)
  isActive      Boolean                @default(true)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  subscriptions UserSubscription[]

  @@map("subscription_plans")
}

model UserSubscription {
  id            String              @id @default(cuid())
  userId        String
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId        String
  plan          SubscriptionPlan    @relation(fields: [planId], references: [id], onDelete: Restrict)
  status        SubscriptionStatus  @default(Pending)
  autoRenew     Boolean             @default(true)
  startsAt      DateTime            @default(now())
  endsAt        DateTime?
  nextBillingAt DateTime?
  adminNotes    String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@map("user_subscriptions")
}

model KycDocument {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       KycDocumentType
  fileUrl    String
  fileName   String
  mimeType   String
  status     KycStatus       @default(NotSubmitted)
  adminNotes String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@map("kyc_documents")
}

// ───────────────────────────────────────────────────────────
// Hotels & Rooms
// ───────────────────────────────────────────────────────────

model Hotel {
  id          String   @id @default(cuid())
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  description String
  starRating  Int
  location    String
  city        String?
  latitude    Float?
  longitude   Float?
  amenities   String[]
  images      String[]
  policies    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rooms    Room[]
  bookings Booking[]

  @@map("hotels")
}

model Room {
  id             String   @id @default(cuid())
  hotelId        String
  hotel          Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomType       String
  bedType        String
  maxGuests      Int
  pricePerNight  Decimal  @db.Decimal(10, 2)
  size           Float?
  amenities      String[]
  images         String[]
  totalUnits     Int      @default(1)
  availableUnits Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  bookings Booking[]

  @@map("rooms")
}

// ───────────────────────────────────────────────────────────
// Bundles (day-by-day itinerary)
// ───────────────────────────────────────────────────────────

enum BundleStatus {
  Draft
  Published
  Archived
  SoldOut
}

model Bundle {
  id               String       @id @default(cuid())
  creatorId        String
  creator          User         @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  title            String
  description      String
  durationDays     Int
  destinations     String[]
  images           String[]
  guideName        String?
  price            Decimal      @db.Decimal(10, 2)
  difficulty       String       @default("easy")
  groupSize        Int?
  includedServices String[]
  status           BundleStatus @default(Draft)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  days     BundleDay[]
  bookings Booking[]

  @@map("bundles")
}

model BundleDay {
  id          String   @id @default(cuid())
  bundleId    String
  bundle      Bundle   @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  dayNumber   Int
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items BundleItem[]

  @@map("bundle_days")
}

model BundleItem {
  id               String   @id @default(cuid())
  bundleDayId      String
  bundleDay        BundleDay @relation(fields: [bundleDayId], references: [id], onDelete: Cascade)
  type             String
  title            String
  description      String?
  startTime        String?
  endTime          String?
  location         String?
  cost             Decimal? @db.Decimal(10, 2)
  includedServices String[]
  metadata         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("bundle_items")
}

// ───────────────────────────────────────────────────────────
// Bookings (placeholder — populated in a later phase)
// ───────────────────────────────────────────────────────────

enum BookingType {
  HotelRoom
  Bundle
}

enum BookingStatus {
  Pending
  Confirmed
  Active
  Completed
  Cancelled
  Refunded
}

model Booking {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            BookingType
  hotelId         String?
  hotel           Hotel?        @relation(fields: [hotelId], references: [id])
  roomId          String?
  room            Room?         @relation(fields: [roomId], references: [id])
  bundleId        String?
  bundle          Bundle?       @relation(fields: [bundleId], references: [id])
  startDate       DateTime
  endDate         DateTime?
  numGuests       Int           @default(1)
  totalAmount     Decimal       @db.Decimal(10, 2)
  commissionRate  Decimal?      @db.Decimal(5, 2)
  commissionAmount Decimal?     @db.Decimal(10, 2)
  status          BookingStatus @default(Pending)
  metadata        Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("bookings")
}
